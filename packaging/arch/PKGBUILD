# Maintainer: qtIDM Maintainers <maintainers@example.invalid>
# The build script rewrites pkgver from CMakeLists.txt before calling makepkg.
pkgname=qtidm
pkgver=0.3.2
pkgrel=1
pkgdesc="Fast, native Internet Download Manager for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/ameya-deshpande-5056/qtIDM"
license=('MIT')
depends=('qt6-base' 'curl' 'sqlite' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'gcc')
optdepends=(
  'ffmpeg: HLS and DASH downloads'
  '7zip: automatic archive extraction'
  'libsecret: Secret Service credential storage'
  'yt-dlp: social media downloads'
  'deno: JavaScript challenge solver for YouTube downloads'
  'chromium: JavaScript-rendered site grabbing'
)
backup=(
  'etc/opt/chrome/native-messaging-hosts/io.qtidm.native.json'
  'etc/chromium/native-messaging-hosts/io.qtidm.native.json'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  # build-arch.sh sets this for a --arch/--toolchain cross build.
  local toolchain=()
  if [ -n "${QTIDM_CMAKE_TOOLCHAIN_FILE:-}" ]; then
    toolchain+=(-DCMAKE_TOOLCHAIN_FILE="$QTIDM_CMAKE_TOOLCHAIN_FILE")
  fi
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DQTIDM_BUILD_TESTS=OFF \
    -DQTIDM_CHROME_EXTENSION_ID="${QTIDM_CHROME_EXTENSION_ID:-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}" \
    "${toolchain[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
